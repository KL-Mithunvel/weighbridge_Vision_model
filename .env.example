# Copy this file to .env (already gitignored) and fill in real values.
# Never commit .env or paste API keys into chat/session logs.

# Roboflow MCP server auth — https://app.roboflow.com/settings/api
# Required for the roboflow plugin's MCP tools (mcp__plugin_roboflow_roboflow__*)
# to connect. See docs/ROBOFLOW_INTEGRATION.md.
ROBOFLOW_API_KEY=

# AWS S3 access for the raw camera images (bucket smtw-weighbridge-archive).
# Personal IAM access key for THIS laptop only — see docs/AWS_ACCESS.md for how
# to create it. The secret is shown only once; rotate it if it leaks; delete the
# key in IAM when the project ends. boto3 / development/aws_s3.py read these.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
